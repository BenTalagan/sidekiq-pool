#!/usr/bin/env ruby

$TESTING = false

require_relative '../lib/sidekiq/pool/cli'

begin
  cli = Sidekiq::Pool::CLI.instance
  Sidekiq::Pool.instance_variable_set(:@pooled, true)
  cli.parse
  cli.run
rescue => e
  raise e if $DEBUG
  STDERR.puts e.message
  STDERR.puts e.backtrace.join("\n")
  exit 1
end
